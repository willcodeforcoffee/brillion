# Copy to .env and fill in real values. .env itself is gitignored.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=brillion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brillion
POSTGRES_PORT=5432

# For `cargo run` outside Docker Compose (points at the port mapping
# above). Keep the user/password/db in sync with the POSTGRES_* values
# above by hand — this is a plain literal, not a variable expansion.
DATABASE_URL=postgres://brillion:change-me@localhost:5432/brillion

# --- RustFS (S3-compatible media storage, SPEC.md §5) --------------------
RUSTFS_ROOT_USER=brillion
RUSTFS_ROOT_PASSWORD=change-me
S3_BUCKET=brillion-media

# --- Backend --------------------------------------------------------------
# Public URL this instance is reachable at (through the proxy). Used to
# build actor/post URLs and the user@domain address (SPEC.md §3.1) — for
# local dev with the default proxy ports this is just http://localhost;
# in production use your real https:// domain.
PUBLIC_BASE_URL=http://localhost
RUST_LOG=info
# Origin the frontend dev server (Vite) runs on — allowed via CORS.
# Needed whether the backend runs via `cargo run -- serve` or the full
# Docker Compose stack: `npm run dev` always runs separately from
# either (there's no static-file-serving fallback wired into `backend`
# yet), so the SPA on :5173 is always a different origin.
FRONTEND_ORIGIN=http://localhost:5173

# --- Proxy ------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
