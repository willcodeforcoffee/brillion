# Copy to .env and fill in real values. .env itself is gitignored.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=brillion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brillion

# --- RustFS (S3-compatible media storage, SPEC.md §5) --------------------
RUSTFS_ROOT_USER=brillion
RUSTFS_ROOT_PASSWORD=change-me
S3_BUCKET=brillion-media

# --- Backend --------------------------------------------------------------
# Public URL this instance is reachable at (through the proxy). Used to
# build actor/post URLs and the user@domain address (SPEC.md §3.1) — for
# local dev with the default proxy ports this is just http://localhost;
# in production use your real https:// domain.
PUBLIC_BASE_URL=http://localhost
RUST_LOG=info

# --- Proxy ------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
