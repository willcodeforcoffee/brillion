# Copy to .env and fill in real values. .env itself is gitignored.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=brillion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brillion

# --- RustFS (S3-compatible media storage, SPEC.md §5) --------------------
# NOTE: confirm these env var names against RustFS's own docs
# (https://rustfs.com) before relying on them — filled in here as a
# reasonable placeholder pending that check.
RUSTFS_ROOT_USER=brillion
RUSTFS_ROOT_PASSWORD=change-me
S3_BUCKET=brillion-media

# --- Backend --------------------------------------------------------------
DOMAIN=localhost
RUST_LOG=info

# --- Proxy ------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
