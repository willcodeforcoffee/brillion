# Copy to .env for local dev. Points the SPA at wherever the backend is
# actually reachable:
# - `cargo run -- serve` directly (no Caddy): http://localhost:3000
# - Full stack via `docker compose up --build` (Caddy on :80, needed for
#   the media-upload flow's CORS/signing to work — see backend/src/media.rs):
#   http://localhost
VITE_API_BASE=http://localhost
